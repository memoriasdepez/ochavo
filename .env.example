# Configuración pública de la app web de Firebase. No usar claves de administrador.
VITE_FIREBASE_API_KEY=AIzaSyBeKANolLouQSVr1Qpmi_akb4vBRxMsp44
VITE_FIREBASE_AUTH_DOMAIN=brote-62d26.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=brote-62d26
VITE_FIREBASE_APP_ID=1:226760894540:web:5d4bc992cc93fb7eceace9

# Solo para pruebas locales. El build de producción rechaza el modo emulador.
VITE_USE_EMULATORS=false

# Claves PUBLICAS de RevenueCat, distintas para cada tienda. Dejar vacias desactiva compras.
# Nunca escribir secretos sk_, credenciales de Google o claves privadas de Apple en variables VITE_.
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_WEB_KEY=
VITE_BILLING_API_URL=
# production: web key rcb_ (never rcb_sb_). Empty keys keep checkout disabled.
# sandbox: use rcb_sb_ plus a DIFFERENT Firebase project and a sandbox billing backend.
# Never use test receipts with the public brote-62d26 account/progress database.
VITE_BILLING_ENVIRONMENT=production

# Public Google Analytics measurement ID; collection only on web after consent.
VITE_WEB_ANALYTICS_ID=G-EQQL1L5GSQ

# Advertising is disabled until the publisher account, consent message and app/site are ready.
# Modes: disabled | live. Use test only in a dedicated local ads-test build.
VITE_ANDROID_ADS_MODE=disabled
VITE_ADMOB_APP_APPROVED=false
